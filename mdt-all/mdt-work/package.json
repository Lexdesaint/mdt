  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && npm run postbuild && npm run prisma:generate",
    "postbuild": "cp -r src/generated dist/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "dev": "npm run seed && ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "ts-node src/prisma/seed.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "update:prisma_DB": "npx prisma migrate dev --name update_schema && npx prisma generate"
  },
